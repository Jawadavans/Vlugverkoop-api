### Get all cars
GET http://127.0.0.1:8080/cars

### Delete car with id 1
DELETE http://127.0.0.1:8080/cars/1

### Delete a car that does not exist
DELETE http://127.0.0.1:8080/cars/99

### Create a new car
POST http://127.0.0.1:8080/cars
Content-Type: application/json

{
  "brand": "Audi",
  "model": "A3",
  "year": 2019,
  "price": 17500.0,
  "mileage": 60000,
  "doors": 5
}

### Get all scooters
GET http://127.0.0.1:8080/scooters

### Search and filter scooters
GET http://127.0.0.1:8080/scooters?plateColor=BLUE&maxPrice=1500

### Get the plate colours for the dropdown in the app
GET http://127.0.0.1:8080/scooters/plate-colors

### Get one scooter
GET http://127.0.0.1:8080/scooters/1

### Update scooter 1 (for example after a price change)
PUT http://127.0.0.1:8080/scooters/1
Content-Type: application/json

{
  "brand": "Vespa",
  "model": "Primavera",
  "year": 2021,
  "price": 2395.0,
  "mileage": 4600,
  "maxSpeedKmh": 45
}

### Update a scooter that does not exist (gives 404 Not Found)
PUT http://127.0.0.1:8080/scooters/99
Content-Type: application/json

{
  "brand": "Vespa",
  "model": "Primavera",
  "year": 2021,
  "price": 2395.0,
  "mileage": 4600,
  "maxSpeedKmh": 45
}

### Delete scooter with id 1
DELETE http://127.0.0.1:8080/scooters/1

### Delete a scooter that does not exist
DELETE http://127.0.0.1:8080/scooters/99

### Create a new scooter (45 km/h → yellow plate)
POST http://127.0.0.1:8080/scooters
Content-Type: application/json

{
  "brand": "Peugeot",
  "model": "Kisbee",
  "year": 2022,
  "price": 1750.0,
  "mileage": 2500,
  "maxSpeedKmh": 45
}

### Create a scooter with an invalid speed (gives 400 Bad Request)
POST http://127.0.0.1:8080/scooters
Content-Type: application/json

{
  "brand": "Peugeot",
  "model": "Kisbee",
  "year": 2022,
  "price": 1750.0,
  "mileage": 2500,
  "maxSpeedKmh": 80
}

### Search cars on brand or model
GET http://127.0.0.1:8080/cars?search=volkswagen

### Filter cars on price and doors
GET http://127.0.0.1:8080/cars?maxPrice=20000&doors=5

### Get one car
GET http://127.0.0.1:8080/cars/2

### Get a car that does not exist (404)
GET http://127.0.0.1:8080/cars/99

### Create a car with wrong data (400 with errors)
POST http://127.0.0.1:8080/cars
Content-Type: application/json

{
  "brand": "",
  "model": "A3",
  "year": 1900,
  "price": -1.0,
  "mileage": -5,
  "doors": 9
}

### Update a car (200)
PUT http://127.0.0.1:8080/cars/2
Content-Type: application/json

{
  "brand": "Toyota",
  "model": "Yaris",
  "year": 2020,
  "price": 15500.0,
  "mileage": 43000,
  "doors": 5
}

### Update a car that does not exist (404)
PUT http://127.0.0.1:8080/cars/99
Content-Type: application/json

{
  "brand": "Toyota",
  "model": "Yaris",
  "year": 2020,
  "price": 15500.0,
  "mileage": 43000,
  "doors": 5
}